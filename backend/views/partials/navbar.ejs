<nav class="navbar">
    <div class="container">
        <a href="/" class="navbar-brand">
            <div class="brand-icon"><i class="fas fa-fire"></i></div>
            NaanNow
        </a>

        <button class="nav-toggle" aria-label="Toggle navigation">
            <i class="fas fa-bars"></i>
        </button>

        <div class="navbar-links">
            <a href="/">Home</a>

            <% if (typeof currentUser !== 'undefined' && currentUser) { %>

                <% if (currentUser.role === 'customer') { %>
                    <a href="/cart"><i class="fas fa-shopping-cart"></i> Cart</a>
                    <a href="/orders/my-orders">My Orders</a>
                    <a href="/wallet">Wallet</a>
                    <a href="/users/wishlist"><i class="fas fa-heart"></i> Wishlist</a>
                <% } %>

                <% if (currentUser.role === 'restaurant_owner') { %>
                    <a href="/restaurants/my-shop">My Shop</a>
                    <a href="/orders/restaurant-queue">Orders</a>
                    <a href="/wallet">Wallet</a>
                <% } %>

                <% if (currentUser.role === 'rider') { %>
                    <a href="/orders/available-deliveries">Deliveries</a>
                    <a href="/wallet/earnings">Earnings</a>
                <% } %>

                <% if (currentUser.role === 'admin') { %>
                    <a href="/admin/dashboard">Dashboard</a>
                    <a href="/admin/users">Users</a>
                    <a href="/admin/restaurants">Restaurants</a>
                    <a href="/admin/riders">Riders</a>
                    <a href="/admin/settings">Settings</a>
                <% } %>

                <div class="nav-user">
                    <img src="<%= currentUser.profilePic || '/uploads/defaults/profile-avatar.png' %>" alt="Avatar" class="nav-user-avatar">
                    <div>
                        <div class="nav-user-name"><%= currentUser.name %></div>
                        <div class="nav-user-role"><%= currentUser.role.replace('_', ' ') %></div>
                    </div>
                </div>

                <a href="/auth/logout" class="btn btn-ghost btn-sm">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>

            <% } else { %>
                <a href="/auth/login" class="btn btn-ghost btn-sm">Login</a>
                <a href="/auth/register" class="btn btn-primary btn-sm">Sign Up</a>
            <% } %>
        </div>
    </div>
</nav>
