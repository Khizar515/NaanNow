<% layout('layouts/main') %>

<div class="container">
    <div class="page-header">
        <div>
            <h1><%= shop.name %></h1>
            <p>Manage your restaurant, menu, and orders</p>
        </div>
        <div class="d-flex gap-sm">
            <% if (shop.isApproved) { %>
                <form action="/restaurants/<%= shop._id %>/toggle-status" method="POST">
                    <button type="submit" class="btn <%= shop.isOpen ? 'btn-danger' : 'btn-success' %>">
                        <i class="fas fa-power-off"></i> <%= shop.isOpen ? 'Close Shop' : 'Open Shop' %>
                    </button>
                </form>
            <% } %>
            <a href="/orders/restaurant-queue" class="btn btn-secondary">
                <i class="fas fa-list"></i> View Orders
            </a>
        </div>
    </div>

    <!-- Status Banner -->
    <div class="card mb-xl">
        <div class="d-flex align-center gap-lg">
            <div>
                <% if (!shop.isApproved) { %>
                    <span class="badge badge-pending"><i class="fas fa-clock"></i> Pending Approval</span>
                <% } else if (shop.isOpen) { %>
                    <span class="badge badge-success"><i class="fas fa-circle"></i> Open</span>
                <% } else { %>
                    <span class="badge badge-danger"><i class="fas fa-circle"></i> Closed</span>
                <% } %>
                <p class="text-muted mt-sm" style="font-size:var(--font-size-sm);">
                    <i class="fas fa-info-circle"></i> <%= shop.adminStatusMessage %>
                </p>
            </div>
        </div>
    </div>

    <div class="grid grid-2">
        <!-- Shop Details Card -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Shop Details</h3>
                <a href="/restaurants/<%= shop._id %>/edit" class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i> Edit</a>
            </div>
            <div class="form-group">
                <span class="form-label">Cuisine</span>
                <p><%= shop.cuisineType %></p>
            </div>
            <div class="form-group">
                <span class="form-label">Address</span>
                <p><%= shop.address %></p>
            </div>
            <div class="form-group">
                <span class="form-label">Phone</span>
                <p><%= shop.phone %></p>
            </div>
            <div class="form-group">
                <span class="form-label">Location</span>
                <div id="shop-map" style="height: 200px; width: 100%; border-radius: var(--radius-sm); z-index: 1;"></div>
            </div>
        </div>

        <!-- Add Menu Item Card -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Add Menu Item</h3>
            </div>
            <form action="/menu/add" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="itemName" class="form-label">Item Name</label>
                    <input type="text" id="itemName" name="name" class="form-control" placeholder="e.g. Chicken Biryani" required>
                </div>
                <div class="form-group">
                    <label for="description" class="form-label">Description</label>
                    <textarea id="description" name="description" class="form-control" placeholder="Describe this dish..." required></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="basePrice" class="form-label">Base Price (Rs.)</label>
                        <input type="number" id="basePrice" name="basePrice" class="form-control" placeholder="500" required min="1">
                    </div>
                    <div class="form-group">
                        <label for="category" class="form-label">Category</label>
                        <input type="text" id="category" name="category" class="form-control" placeholder="e.g. Mains" required>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Item Image</label>
                    <input type="file" name="image" class="form-file-input form-control" accept="image/*">
                </div>
                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-plus"></i> Add to Menu
                </button>
            </form>
        </div>
    </div>

    <!-- Current Menu -->
    <div class="mt-xl">
        <div class="page-header">
            <h2>Your Menu</h2>
        </div>

        <% if (menuItems.length === 0) { %>
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fas fa-utensils"></i></div>
                <h3>No Items Yet</h3>
                <p>Add your first menu item above to get started.</p>
            </div>
        <% } else { %>
            <div class="table-wrapper">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Category</th>
                            <th>Base Price</th>
                            <th>Available</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% menuItems.forEach(item => { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-center gap-md">
                                        <% if (item.imageUrl) { %>
                                            <img src="<%= item.imageUrl %>" alt="" style="width:40px;height:40px;border-radius:var(--radius-sm);object-fit:cover;">
                                        <% } %>
                                        <div>
                                            <strong><%= item.name %></strong>
                                            <div class="text-dim" style="font-size:var(--font-size-xs);"><%= item.description.substring(0, 50) %>...</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge badge-info"><%= item.category %></span></td>
                                <td>Rs. <%= item.basePrice %></td>
                                <td>
                                    <span class="badge <%= item.isAvailable ? 'badge-success' : 'badge-danger' %>">
                                        <%= item.isAvailable ? 'Yes' : 'No' %>
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex gap-sm">
                                        <a href="/menu/<%= item._id %>/edit" class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></a>
                                        <form action="/menu/<%= item._id %>/toggle-availability" method="POST" style="display:inline;">
                                            <button type="submit" class="btn btn-sm <%= item.isAvailable ? 'btn-warning' : 'btn-success' %>">
                                                <%= item.isAvailable ? 'Disable' : 'Enable' %>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const lat = <%= shop.location.coordinates[1] %>;
        const lng = <%= shop.location.coordinates[0] %>;

        const map = L.map('shop-map').setView([lat, lng], 15);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        L.marker([lat, lng]).addTo(map);
    });
</script>
