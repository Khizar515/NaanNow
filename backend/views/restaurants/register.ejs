<% layout('layouts/main') %>

<div class="container" style="max-width: 700px;">
    <div class="page-header">
        <div>
            <h1>Register Your Restaurant</h1>
            <p>Fill in your shop details and upload verification documents</p>
        </div>
    </div>

    <div class="card">
        <form action="/restaurants/register" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label for="name" class="form-label">Restaurant Name</label>
                <input type="text" id="name" name="name" class="form-control" placeholder="e.g. Naan Stop" required>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="cuisineType" class="form-label">Cuisine Type</label>
                    <input type="text" id="cuisineType" name="cuisineType" class="form-control" placeholder="e.g. Pakistani, Fast Food" required>
                </div>
                <div class="form-group">
                    <label for="phone" class="form-label">Contact Phone</label>
                    <input type="text" id="phone" name="phone" class="form-control" placeholder="03XX-XXXXXXX" required>
                </div>
            </div>

            <div class="form-group">
                <label for="address" class="form-label">Shop Address</label>
                <input type="text" id="address" name="address" class="form-control" placeholder="Full street address" required>
            </div>

            <div class="form-group">
                <label class="form-label">Restaurant Location on Map</label>
                <div id="map" style="height: 300px; width: 100%; border-radius: var(--radius-sm); z-index: 1;"></div>
                <span class="form-text mb-lg">Click or drag the marker to set your exact location. Coordinates are required for delivery distance calculations.</span>
                <input type="hidden" id="longitude" name="longitude" required>
                <input type="hidden" id="latitude" name="latitude" required>
            </div>

            <div class="form-group">
                <label class="form-label">Verification Documents (CNIC, Utility Bill, etc.)</label>
                <input type="file" name="documents" class="form-file-input form-control" multiple accept="image/*,.pdf">
                <span class="form-text">Upload up to 5 files (images or PDFs)</span>
            </div>

            <button type="submit" class="btn btn-primary btn-block btn-lg">
                <i class="fas fa-store"></i> Submit for Approval
            </button>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Default to Lahore, Pakistan if geolocation fails
        let defaultLat = 31.5204;
        let defaultLng = 74.3587;

        const map = L.map('map').setView([defaultLat, defaultLng], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        let marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);
        
        function updateInputs(lat, lng) {
            document.getElementById('latitude').value = lat;
            document.getElementById('longitude').value = lng;
        }
        
        // Initial set
        updateInputs(defaultLat, defaultLng);

        // Update on drag
        marker.on('dragend', function (e) {
            const pos = marker.getLatLng();
            updateInputs(pos.lat, pos.lng);
        });

        // Update on click
        map.on('click', function(e) {
            marker.setLatLng(e.latlng);
            updateInputs(e.latlng.lat, e.latlng.lng);
        });

        // Try to get user's actual location
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(position) {
                const lat = position.coords.latitude;
                const lng = position.coords.longitude;
                map.setView([lat, lng], 15);
                marker.setLatLng([lat, lng]);
                updateInputs(lat, lng);
            });
        }
    });
</script>
