<%- include('partials/head') %>
<%- include('partials/navbar') %>
<%- include('partials/cart-sidebar') %>

<div class="orders-page-container">
  <!-- Breadcrumbs Bar -->
  <div class="orders-header-bar">
    <div class="orders-breadcrumbs">
      <button class="breadcrumb-link" onclick="window.location.href='/'">Home</button>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">My Orders</span>
    </div>
    
    <button class="back-home-btn" onclick="window.location.href='/'">
      ← Back to Shopping
    </button>
  </div>

  <h1 class="orders-title">My Orders</h1>

  <!-- 1. Empty Orders State -->
  <div class="orders-empty-card" id="orders-empty-state" style="display: none;">
    <div class="orders-empty-icon">🧺</div>
    <h2>No Orders Placed Yet!</h2>
    <p>You haven't ordered any fresh, hot naans or items yet. When you do, they will appear right here.</p>
    <button class="orders-back-menu-btn" onclick="window.location.href='/'">
      Browse Menu
    </button>
  </div>

  <!-- 2. Orders List State -->
  <div class="orders-list" id="orders-history-list">
    <!-- Rendered dynamically by JS -->
  </div>
</div>

<!-- Custom Page Scripts -->
<script src="/js/orders.js"></script>

<%- include('partials/footer') %>
