<!-- Interactions Logic for Rider Navbar -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // --- Online Status Logic ---
    const statusToggle = document.getElementById('rider-status-toggle');
    const statusDot = document.getElementById('status-dot');
    const statusText = document.getElementById('status-text');

    // Retrieve state from localStorage
    const savedStatus = localStorage.getItem('naannow_rider_status') || 'online';
    if (savedStatus === 'online') {
      statusToggle.checked = true;
      setStatusUI(true);
    } else {
      statusToggle.checked = false;
      setStatusUI(false);
    }

    statusToggle.addEventListener('change', function () {
      setStatusUI(this.checked);
      localStorage.setItem('naannow_rider_status', this.checked ? 'online' : 'offline');
    });

    function setStatusUI(isOnline) {
      if (isOnline) {
        statusDot.className = 'status-dot online';
        statusText.textContent = 'Online';
        statusText.style.color = '#5CA136';
      } else {
        statusDot.className = 'status-dot offline';
        statusText.textContent = 'Offline';
        statusText.style.color = '#EF4444';
      }
    }

    // --- Active Orders Counter ---
    const orders = JSON.parse(localStorage.getItem('naannow_orders')) || [];
    const activeOrders = orders.filter(o => o.status !== 'Delivered');
    const badge = document.getElementById('active-orders-badge');

    if (activeOrders.length > 0) {
      badge.textContent = activeOrders.length;
      badge.style.display = 'inline-flex';

      // Update Mobile bottom navigation Active Map link to lead directly to the first active order
      const mapLink = document.getElementById('mobile-nav-map');
      if (mapLink) {
        mapLink.setAttribute('href', `/rider/deliver/${activeOrders[0].id}`);
      }
    } else {
      badge.style.display = 'none';
      const mapLink = document.getElementById('mobile-nav-map');
      if (mapLink) {
        mapLink.addEventListener('click', (e) => {
          e.preventDefault();
          alert('No active delivery order found to track on map!');
        });
      }
    }

    // --- Dropdowns Click Toggles ---
    const setupDropdown = (btnId, dropdownId) => {
      const btn = document.getElementById(btnId);
      const dropdown = document.getElementById(dropdownId);
      if (btn && dropdown) {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          // Close others
          closeAllDropdowns(dropdownId);
          dropdown.classList.toggle('open');
        });
      }
    };

    setupDropdown('rider-notif-btn', 'rider-notif-dropdown');
    setupDropdown('rider-lang-btn', 'rider-lang-dropdown');
    setupDropdown('rider-profile-btn', 'rider-profile-dropdown');

    const closeAllDropdowns = (exceptId) => {
      ['rider-notif-dropdown', 'rider-lang-dropdown', 'rider-profile-dropdown'].forEach(id => {
        if (id !== exceptId) {
          const el = document.getElementById(id);
          if (el) el.classList.remove('open');
        }
      });
    };

    document.addEventListener('click', () => {
      closeAllDropdowns();
    });

    // Mobile navigation active state highlights depending on path
    const path = window.location.pathname;
    document.querySelectorAll('.bottom-nav-item').forEach(item => {
      item.classList.remove('active');
    });

    if (path === '/rider') {
      document.getElementById('mobile-nav-dashboard').classList.add('active');
      document.getElementById('mobile-nav-orders').classList.add('active');
    } else if (path.includes('/rider/deliver/')) {
      document.getElementById('mobile-nav-map').classList.add('active');
    } else if (path === '/profile') {
      document.getElementById('mobile-nav-profile').classList.add('active');
    }
  });

  function clearNotifBadge() {
    const badge = document.getElementById('rider-notif-badge');
    if (badge) badge.style.display = 'none';
    const unreadItems = document.querySelectorAll('.notif-item.unread');
    unreadItems.forEach(item => item.classList.remove('unread'));
  }

  function selectLang(lang) {
    const btn = document.getElementById('rider-lang-btn');
    if (btn) btn.textContent = `${lang.toUpperCase()} 🌐`;
    document.querySelectorAll('#rider-lang-dropdown li').forEach(li => {
      li.classList.remove('active');
      if (li.textContent.toLowerCase().includes(lang)) {
        li.classList.add('active');
      }
    });
  }
</script>