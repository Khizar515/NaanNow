<aside class="filter-sidebar">
  <div class="filter-header">
    <h2>Filter</h2>
    <button class="clear-btn" onclick="window.location.reload()">Clear all</button>
  </div>

  <div class="filter-scroll-area">
    <!-- Sort By Section -->
    <div class="filter-section">
      <h3>Sort by</h3>
      <label class="radio-label">
        <input type="radio" name="sort" checked />
        <span class="radio-custom"></span>
        Relevance
      </label>
      <label class="radio-label">
        <input type="radio" name="sort" />
        <span class="radio-custom"></span>
        Fastest delivery
      </label>
      <label class="radio-label">
        <input type="radio" name="sort" />
        <span class="radio-custom"></span>
        Distance
      </label>
      <label class="radio-label">
        <input type="radio" name="sort" />
        <span class="radio-custom"></span>
        Top rated
      </label>
    </div>

    <!-- Quick Filters Section -->
    <div class="filter-section">
      <h3>Quick filters</h3>
      <div class="pill-group">
        <button class="filter-pill">Ratings 4+</button>
        <button class="filter-pill">
          <span class="icon">🎖️</span> Super Restaurant
        </button>
      </div>
    </div>

    <!-- Offers Section -->
    <div class="filter-section">
      <h3>Offers</h3>
      <label class="checkbox-label">
        <input type="checkbox" />
        <span class="checkbox-custom"></span>
        Free delivery
      </label>
      <label class="checkbox-label">
        <input type="checkbox" />
        <span class="checkbox-custom"></span>
        Accepts vouchers
      </label>
      <label class="checkbox-label">
        <input type="checkbox" checked />
        <span class="checkbox-custom"></span>
        Deals
      </label>
    </div>

    <!-- Cuisines Section -->
    <div class="filter-section">
      <h3>Cuisines</h3>
      <div class="search-input-wrapper">
        <svg width="14" height="14" fill="none" stroke="#777" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="M21 21l-4.35-4.35"></path>
        </svg>
        <input type="text" placeholder="Search for cuisine" id="cuisine-search-input" />
      </div>
      
      <div class="cuisine-list">
        <% 
          const sidebarCuisines = [
            'American', 'BBQ', 'Beverages', 'Biryani', 'Burgers', 
            'Cakes & Bakery', 'Chinese', 'Continental', 'Desserts'
          ];
          sidebarCuisines.forEach((c, index) => {
        %>
          <label class="checkbox-label sidebar-cuisine-item" style="<%= index >= 5 ? 'display: none;' : '' %>">
            <input type="checkbox" value="<%= c %>" class="cuisine-checkbox" />
            <span class="checkbox-custom"></span>
            <%= c %>
          </label>
        <% }) %>
      </div>
      
      <button class="show-more-btn" id="show-more-cuisines-btn">
        Show more 
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-left: 2px;">
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </button>
    </div>

    <!-- Price Section -->
    <div class="filter-section">
      <h3>Price</h3>
      <div class="price-toggle-group">
        <button class="price-btn active">$</button>
        <button class="price-btn">$$</button>
        <button class="price-btn">$$$</button>
      </div>
    </div>
  </div>
</aside>

<script>
  // Simple sidebar specific logic for collapsing cuisines checklist
  document.addEventListener('DOMContentLoaded', () => {
    const showMoreBtn = document.getElementById('show-more-cuisines-btn');
    const cuisineItems = document.querySelectorAll('.sidebar-cuisine-item');
    const cuisineSearchInput = document.getElementById('cuisine-search-input');
    const checkboxes = document.querySelectorAll('.cuisine-checkbox');
    let expanded = false;

    if (showMoreBtn) {
      showMoreBtn.addEventListener('click', () => {
        expanded = !expanded;
        cuisineItems.forEach((item, index) => {
          if (index >= 5) {
            item.style.display = expanded ? 'flex' : 'none';
          }
        });
        showMoreBtn.innerHTML = expanded ? 
          `Show less <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="transform: rotate(180deg); margin-left: 2px;"><path d="M6 9l6 6 6-6"></path></svg>` : 
          `Show more <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-left: 2px;"><path d="M6 9l6 6 6-6"></path></svg>`;
      });
    }

    if (cuisineSearchInput) {
      cuisineSearchInput.addEventListener('input', () => {
        const query = cuisineSearchInput.value.toLowerCase();
        cuisineItems.forEach(item => {
          const text = item.textContent.trim().toLowerCase();
          if (text.includes(query)) {
            item.style.display = 'flex';
          } else {
            item.style.display = 'none';
          }
        });
      });
    }

    // Connect sidebar checkbox filters to main app.js trigger filters
    checkboxes.forEach(box => {
      box.addEventListener('change', () => {
        const checkedValues = Array.from(checkboxes)
          .filter(b => b.checked)
          .map(b => b.value);
        
        // If items are checked, filter by first selected cuisine for demo, or emit events
        if (checkedValues.length > 0) {
          // Let's call the global select cuisine logic if accessible
          const customCuisineName = checkedValues[0];
          // Dispatch custom event to select cuisine circle in app.js
          const event = new CustomEvent('sidebarCuisineSelect', { detail: customCuisineName });
          document.dispatchEvent(event);
        } else {
          const event = new CustomEvent('sidebarCuisineSelect', { detail: 'All' });
          document.dispatchEvent(event);
        }
      });
    });
  });
</script>
