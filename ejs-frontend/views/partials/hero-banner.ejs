<div class="hero-banner">
  <div class="hero-content">
    <h1 class="hero-greeting">Welcome, <%= userName %></h1>
    <div class="hero-subtext">
      What are you craving today? 
      <svg class="info-icon" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="cursor: pointer; margin-left: 4px;">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
    </div>

    <div class="craving-pills">
      <button class="pill icon-btn" aria-label="Refresh">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
        </svg>
      </button>
      <div class="pills-list fading-in">
        <% for(let i = 0; i < 5; i++) { %>
          <button class="pill" onclick="document.dispatchEvent(new CustomEvent('cuisineSelect', {detail: '<%= categories[i] %>'}))">
            <svg width="18" height="18" fill="#e87b1e" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
            </svg>
            <%= categories[i] %>
          </button>
        <% } %>
      </div>
    </div>
  </div>

  <div class="hero-illustration">
    <img src="/assets/naan-removebg.png" alt="Food Cloche" class="naan-dome-img" />
  </div>
</div>
