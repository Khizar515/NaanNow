<%- include('partials/head') %>
<%- include('partials/navbar') %>
<%- include('partials/cart-sidebar') %>

<div class="track-page-container state-loading" id="track-container">
  
  <!-- Breadcrumbs & Go Back -->
  <div class="track-header-bar">
    <div class="track-breadcrumbs">
      <button class="breadcrumb-link" onclick="window.location.href='/'">Home</button>
      <span class="breadcrumb-separator">/</span>
      <button class="breadcrumb-link" onclick="window.location.href='/orders'">My Orders</button>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">Track Order</span>
    </div>
    <button class="back-home-btn" onclick="window.location.href='/orders'">
      ← Back to Orders
    </button>
  </div>

  <!-- SKELETON LOADER STATE (Visible when .state-loading is active) -->
  <div class="skeleton-wrapper" id="skeleton-loader">
    <div class="skeleton-header"></div>
    <div class="skeleton-timeline">
      <div class="skeleton-circle"></div>
      <div class="skeleton-line"></div>
      <div class="skeleton-circle"></div>
      <div class="skeleton-line"></div>
      <div class="skeleton-circle"></div>
      <div class="skeleton-line"></div>
      <div class="skeleton-circle"></div>
      <div class="skeleton-line"></div>
      <div class="skeleton-circle"></div>
    </div>
    <div class="skeleton-grid">
      <div class="skeleton-col-left">
        <div class="skeleton-map"></div>
        <div class="skeleton-card mini"></div>
      </div>
      <div class="skeleton-col-right">
        <div class="skeleton-card"></div>
        <div class="skeleton-chat"></div>
      </div>
    </div>
  </div>

  <!-- ACTUAL ORDER TRACKING CONTENT (Hidden during skeleton state) -->
  <div class="tracking-content-grid" id="actual-content" style="display: none;">
    <!-- Top Row: Order Basic Info Card -->
    <div class="order-summary-header-card">
      <div class="summary-meta-left">
        <span class="brand-tag">NaanNow Live Track</span>
        <h1 class="order-title">Order Reference: <span id="info-order-id">NN-XXXXXX</span></h1>
        <p class="order-date-text">Placed on <span id="info-order-date">--</span> via <span id="info-order-payment">--</span></p>
      </div>
      <div class="summary-meta-right">
        <div class="meta-price-box">
          <span class="price-lbl">Total Amount Paid</span>
          <span class="price-val" id="info-order-total">Rs --</span>
        </div>
      </div>
    </div>

    <!-- Live Order Status Progress Timeline -->
    <div class="timeline-status-card">
      <h3>Live Order Progress</h3>
      <div class="progress-timeline-steps">
        <div class="progress-step-item pending" id="stage-placed">
          <div class="step-icon-wrapper">🥣</div>
          <div class="step-label">Order Placed</div>
          <span class="step-time" id="time-placed">--:--</span>
        </div>
        <div class="progress-line-bar" id="line-placed"></div>

        <div class="progress-step-item pending" id="stage-preparing">
          <div class="step-icon-wrapper">🔥</div>
          <div class="step-label">Preparing</div>
          <span class="step-time" id="time-preparing">--:--</span>
        </div>
        <div class="progress-line-bar" id="line-preparing"></div>

        <div class="progress-step-item pending" id="stage-assigned">
          <div class="step-icon-wrapper">🚴</div>
          <div class="step-label">Rider Assigned</div>
          <span class="step-time" id="time-assigned">--:--</span>
        </div>
        <div class="progress-line-bar" id="line-assigned"></div>

        <div class="progress-step-item pending" id="stage-ontheway">
          <div class="step-icon-wrapper">🛵</div>
          <div class="step-label">On The Way</div>
          <span class="step-time" id="time-ontheway">--:--</span>
        </div>
        <div class="progress-line-bar" id="line-ontheway"></div>

        <div class="progress-step-item pending" id="stage-delivered">
          <div class="step-icon-wrapper">✅</div>
          <div class="step-label">Delivered</div>
          <span class="step-time" id="time-delivered">--:--</span>
        </div>
      </div>
    </div>

    <!-- Grid Column Layout -->
    <div class="tracking-details-grid">
      <!-- Left Column: Map and Estimated Time -->
      <div class="details-left-column">
        <!-- Leaflet Map Container -->
        <div class="map-container-card">
          <div id="tracking-map"></div>
          <div class="map-overlay-badge">
            <span class="pulse-dot-green"></span> Live Location Updates
          </div>
        </div>

        <!-- Estimated Delivery Time Card -->
        <div class="etd-info-card">
          <div class="etd-icon">⏳</div>
          <div class="etd-details">
            <span class="etd-lbl">Estimated Delivery Time</span>
            <h2 class="etd-val" id="info-countdown">-- mins</h2>
            <p class="etd-sub">Our tandoor rider is moving fast to bring your piping hot Naans!</p>
          </div>
        </div>

        <!-- Delivery Address Details Card -->
        <div class="address-details-card">
          <h3>Delivery Details</h3>
          <div class="address-row">
            <strong>Customer:</strong>
            <span id="info-cust-name">--</span>
          </div>
          <div class="address-row">
            <strong>Contact Phone:</strong>
            <span id="info-cust-phone">--</span>
          </div>
          <div class="address-row">
            <strong>Delivery Address:</strong>
            <span id="info-cust-address">--</span>
          </div>
          <div class="address-row" id="info-instructions-row" style="display: none;">
            <strong>Rider Instructions:</strong>
            <span id="info-cust-instructions">--</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Rider Card and Chat Box -->
      <div class="details-right-column">
        <!-- Rider Info Card -->
        <div class="rider-info-card">
          <div class="rider-header">
            <img src="" alt="Rider Profile" class="rider-avatar" id="info-rider-img" />
            <div class="rider-meta">
              <span class="rider-badge-tag">Your NaanNow Rider</span>
              <h4 class="rider-name" id="info-rider-name">--</h4>
              <p class="rider-vehicle" id="info-rider-vehicle">--</p>
            </div>
          </div>
          <div class="rider-actions">
            <a href="tel:+923001234567" class="rider-btn call-btn" id="info-rider-phone">
              <span class="btn-icon">📞</span> Call Rider
            </a>
          </div>
        </div>

        <!-- Chat Box Panel -->
        <div class="chat-panel-card">
          <div class="chat-header">
            <div class="chat-header-left">
              <span class="chat-status-dot"></span>
              <h4>Rider Chat</h4>
            </div>
            <div class="chat-unread-badge" id="chat-unread-indicator" style="display: none;">0</div>
          </div>
          
          <!-- Message Bubble Container -->
          <div class="chat-message-log" id="chat-msg-container">
            <!-- Mock/Live message bubbles populated dynamically -->
          </div>

          <!-- Chat Input -->
          <form class="chat-input-bar" id="chat-send-form" onsubmit="return false;">
            <input type="text" id="chat-text-input" placeholder="Type a message to your rider..." required autocomplete="off" />
            <button type="submit" class="chat-send-btn" id="chat-send-btn">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
              </svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating Action Button for Mobile Chat -->
  <button class="mobile-chat-fab" id="mobile-chat-fab" aria-label="Open Chat" style="display: none;">
    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a44.866 44.866 0 01-2.555 4.802c-.135.195.097.419.282.31a19.307 19.307 0 005.185-3.038c.639.154 1.312.24 2.009.24z" />
    </svg>
    <span class="fab-unread-badge" id="mobile-unread-badge" style="display: none;">0</span>
  </button>

  <!-- Dynamic error states... -->
  <div class="order-not-found-card" id="error-state" style="display: none;">
    <div class="error-emoji">⚠️</div>
    <h2>Order Tracking Unavailable</h2>
    <p>We couldn't locate this order reference in your history, or you haven't placed an order yet. Placed orders will automatically show live tracking.</p>
    <button class="finish-checkout-btn" onclick="window.location.href='/'" style="margin-top: 20px;">
      Go to Home Page
    </button>
  </div>

</div>

<!-- CDN SCRIPTS FOR MAPS & WEBSOCKETS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
<script src="/js/track-order.js"></script>

<%- include('partials/footer') %>
