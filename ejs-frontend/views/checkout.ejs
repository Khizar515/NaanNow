<%- include('partials/head') %>
<%- include('partials/navbar') %>
<%- include('partials/cart-sidebar') %>

<!-- 1. Empty Cart Container -->
<div class="checkout-empty-container" id="empty-state" style="display: none;">
  <div class="checkout-empty-card">
    <div class="empty-tokri-icon">🧺</div>
    <h2>Your Tokri is Empty!</h2>
    <p>You haven't added any fresh, hot naans or curry to your basket yet.</p>
    <button class="empty-back-home-btn" onclick="window.location.href='/'">
      Go To Menu
    </button>
  </div>
</div>

<!-- 2. Baking Loader Container -->
<div class="checkout-loading-container" id="loading-state" style="display: none;">
  <div class="tandoor-baking-loader">
    <div class="fire-embers">
      <span class="ember">🔥</span>
      <span class="ember">🔥</span>
      <span class="ember">🔥</span>
    </div>
    <div class="dough-spin">🍞</div>
  </div>
  <h2>Baking Your Order...</h2>
  <p>Sending your request to the NaanNow tandoor. Please do not refresh or close this page.</p>
</div>

<!-- 3. Order Success & Tracking Container -->
<div class="order-success-container" id="success-state" style="display: none;">
  <div class="success-header-card">
    <div class="success-badge">
      <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h2>Bake & Order Placed!</h2>
    <p class="order-id">Order Reference: <span id="success-order-id">NN-XXXXXX</span></p>
    <div class="delivery-etd">
      <span class="etd-label">Estimated Delivery Time</span>
      <span class="etd-value" id="success-countdown">30 mins</span>
    </div>
  </div>

  <!-- Dynamic tracking steps -->
  <div class="tracking-timeline-card">
    <h3>Order Progress</h3>
    <div class="timeline-steps">
      <div class="timeline-step active current" id="step-1">
        <div class="step-icon">🥣</div>
        <div class="step-details">
          <h4>Order Received & Preheating</h4>
          <p id="step-1-text">Preheating tandoor & preparing dough...</p>
        </div>
        <div class="step-status-bar"></div>
      </div>

      <div class="timeline-step" id="step-2">
        <div class="step-icon">🔥</div>
        <div class="step-details">
          <h4>Baking Your Naan</h4>
          <p id="step-2-text">Pending tandoor prep</p>
        </div>
        <div class="step-status-bar"></div>
      </div>

      <div class="timeline-step" id="step-3">
        <div class="step-icon">🛵</div>
        <div class="step-details">
          <h4>Rider Dispatching</h4>
          <p id="step-3-text">Pending bakery completion</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Delivery Details Summary Card -->
  <div class="summary-details-card">
    <h3>Delivery Address Details</h3>
    <p><strong>Rider Destination:</strong> <span id="success-address"></span></p>
    <p><strong>Customer Name:</strong> <span id="success-name"></span></p>
    <p><strong>Contact Phone:</strong> <span id="success-phone"></span></p>
    <p id="success-instructions-row" style="display: none;"><strong>Delivery Note:</strong> <span id="success-instructions"></span></p>
    <p><strong>Payment Mode:</strong> <span id="success-payment"></span></p>
  </div>

  <button class="finish-checkout-btn" onclick="window.location.href='/'">
    Back to Main Menu
  </button>
</div>

<!-- 4. Normal Checkout Form Grid -->
<div class="checkout-page-container" id="checkout-form-state" style="display: none;">
  <!-- Breadcrumb row -->
  <div class="checkout-header-bar">
    <div class="checkout-breadcrumbs">
      <button class="breadcrumb-link" onclick="window.location.href='/'">Home</button>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">Checkout</span>
    </div>
    
    <button class="back-home-btn" onclick="window.location.href='/'">
      ← Back to Shopping
    </button>
  </div>

  <h1 class="checkout-title">Finalize Your Order</h1>

  <form class="checkout-layout-grid" id="checkout-form" onsubmit="return false;" novalidate>
    <!-- Left Form Column -->
    <div class="checkout-forms-column">
      
      <!-- Section 1: Delivery Information -->
      <div class="checkout-section-card">
        <div class="section-title-row">
          <span class="section-number">1</span>
          <h2>Where should we bring your Naan?</h2>
        </div>

        <div class="form-fields-grid">
          <div class="form-group full-width">
            <label for="name">Receiver Name</label>
            <input type="text" id="name" placeholder="e.g. Muhammad Saad" />
            <span class="field-error-message" id="error-name" style="display: none;"></span>
          </div>

          <div class="form-group half-width">
            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" placeholder="e.g. 03001234567" />
            <span class="field-error-message" id="error-phone" style="display: none;"></span>
          </div>

          <div class="form-group half-width">
            <label>Delivery Speed</label>
            <div class="speed-selector-group">
              <label class="speed-option selected" id="speed-standard-label">
                <input type="radio" name="deliverySpeed" value="standard" checked />
                <div class="speed-label-text">
                  <span>Standard</span>
                  <small>Rs 150</small>
                </div>
              </label>

              <label class="speed-option" id="speed-priority-label">
                <input type="radio" name="deliverySpeed" value="priority" />
                <div class="speed-label-text">
                  <span>Priority</span>
                  <small>Rs 250</small>
                </div>
              </label>
            </div>
          </div>

          <div class="form-group full-width">
            <label for="address">Delivery Address</label>
            <textarea id="address" rows="3" placeholder="Street No, House No, Sector/Area, City (e.g. House 42B, Street 11, F-10/2, Islamabad)"></textarea>
            <span class="field-error-message" id="error-address" style="display: none;"></span>
          </div>

          <div class="form-group full-width">
            <label for="instructions">Rider Instructions (Optional)</label>
            <input type="text" id="instructions" placeholder="e.g. Ring doorbell twice / Leave at gate with security" />
          </div>
        </div>
      </div>

      <!-- Section 2: Payment Details -->
      <div class="checkout-section-card">
        <div class="section-title-row">
          <span class="section-number">2</span>
          <h2>Payment Method</h2>
        </div>

        <div class="form-group full-width" style="margin-bottom: 15px;">
          <select id="paymentMethod" name="payment_method" required style="width: 100%; padding: 12px 16px; border-radius: 8px; border: 1.5px solid rgba(79, 46, 29, 0.15); font-family: inherit; font-size: 0.95rem; color: var(--color-roasted); background-color: #fcfcf9;">
            <option value="">Select Payment Method</option>
            <option value="Card">Card</option>
          </select>
          <span class="field-error-message" id="paymentMethodError" style="display: none;"></span>
        </div>

        <!-- Credit/Debit Card Form -->
        <div class="card-form-inputs" id="cardDetails" style="display: none; margin-top: 15px; border-top: 1px solid rgba(79, 46, 29, 0.08); padding-top: 15px;">
          <div class="form-group full-width">
            <label for="cardName">Name on Card</label>
            <input type="text" id="cardName" name="card_name" placeholder="Name on Card" />
            <span class="field-error-message" id="cardNameError" style="display: none;"></span>
          </div>

          <div class="form-group full-width">
            <label for="cardNumber">Card Number</label>
            <input type="text" id="cardNumber" name="card_number" placeholder="Card Number (Full)" maxlength="19" />
            <span class="field-error-message" id="cardNumberError" style="display: none;"></span>
          </div>

          <div style="display: flex; gap: 15px; width: 100%;">
            <div class="form-group" style="flex: 1;">
              <label for="cardExpiry">Expiration Date</label>
              <input type="text" id="cardExpiry" name="card_expiry" placeholder="Expiry (MM/YY)" maxlength="5" />
              <span class="field-error-message" id="cardExpiryError" style="display: none;"></span>
            </div>

            <div class="form-group" style="flex: 1;">
              <label for="cardCVV">CVV / CVC Code</label>
              <input type="password" id="cardCVV" name="card_cvv" placeholder="CVV" maxlength="3" />
              <span class="field-error-message" id="cardCVVError" style="display: none;"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Summary Column -->
    <div class="checkout-summary-column">
      <div class="summary-sticky-card">
        <h3>Basket Summary</h3>
        
        <!-- Items review block -->
        <div class="checkout-items-review" id="checkout-items-list">
          <!-- Populated by JS -->
        </div>

        <!-- Summary calculation rows -->
        <div class="summary-calculation-rows">
          <div class="calc-row">
            <span>Subtotal</span>
            <span id="subtotal-amount">Rs 0</span>
          </div>
          
          <div class="calc-row">
            <span>Delivery Charge</span>
            <span id="delivery-amount">Rs 150</span>
          </div>

          <div class="calc-row">
            <span>Service/Platform Fee</span>
            <span id="platform-amount">Rs 30</span>
          </div>

          <hr class="divider-line" />

          <div class="calc-row grand-total-row">
            <span>Total Amount</span>
            <span id="grand-total-amount">Rs 180</span>
          </div>
        </div>

        <button type="submit" class="submit-order-btn" id="submit-order-btn">
          Bake & Place Order
        </button>
      </div>
    </div>
  </form>
</div>

<!-- Custom Page Scripts -->
<script src="/js/checkout.js"></script>

<%- include('partials/footer') %>
