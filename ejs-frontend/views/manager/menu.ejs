<%- include('../partials/manager-head') %>
  <%- include('../partials/manager-navbar') %>

    <!-- menu.ejs -->
    <div class="portal-container">

      <!-- Page Header -->
      <div class="portal-header-bar">
        <div>
          <h1 class="portal-header-title"><i class="bi bi-egg-fried"></i> Menu Items</h1>
          <p class="portal-header-subtitle">Add, edit, or delete items in your digital menu catalog</p>
        </div>
        <button class="btn-portal btn-portal-primary btn-add-item" data-bs-toggle="modal" data-bs-target="#addItemModal">
          <i class="bi bi-plus-circle"></i> Add New Item
        </button>
      </div>

      <!-- Search & Category Filters Bar -->
      <div class="portal-filter-card">
        <div class="filter-layout-row">
          <!-- Search Input -->
          <div class="search-input-col">
            <div class="portal-input-group">
              <span class="input-group-icon"><i class="bi bi-search"></i></span>
              <input type="text" id="menuSearch" class="portal-input" placeholder="Search menu items...">
            </div>
          </div>
          <!-- Category Badges Filters -->
          <div class="category-filters-col">
            <div id="categoryFilters" class="category-chips-list">
              <!-- Categories rendered dynamically by manager.js -->
            </div>
          </div>
        </div>
      </div>

      <!-- Menu Cards Grid -->
      <div class="menu-items-grid" id="menuGrid">
        <!-- Menu cards loaded dynamically by manager.js -->
        <div class="menu-items-loading">
          <div class="portal-spinner" role="status">
            <span class="visually-hidden">Loading menu...</span>
          </div>
        </div>
      </div>

    </div>

    <!-- ============================================== -->
    <!-- 1. ADD ITEM MODAL -->
    <!-- ============================================== -->
    <div class="portal-modal" id="addItemModal">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header header-primary">
            <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Add Menu Item</h5>
            <button type="button" class="btn-modal-close" data-bs-dismiss="modal" aria-label="Close">&times;</button>
          </div>
          <form id="addItemForm" class="portal-form" novalidate>
            <div class="modal-body">
              <!-- Image Upload -->
              <div class="form-group mb-3">
                <label class="portal-form-label">Food Image</label>
                <div class="portal-upload-zone" onclick="document.getElementById('addItemImgInput').click()">
                  <div id="addItemPlaceholder" class="upload-placeholder">
                    <i class="bi bi-camera upload-icon"></i>
                    <p class="upload-prompt">Click to select food picture</p>
                    <p class="upload-help">JPG, PNG format (High resolution recommended)</p>
                  </div>
                  <div id="addItemPreviewWrapper" class="upload-preview-wrapper d-none">
                    <img id="addItemImgPreview" src="#" alt="Food Preview" class="upload-preview-image">
                    <p class="upload-success-text"><i class="bi bi-check-circle-fill"></i> Image Loaded</p>
                  </div>
                  <input type="file" id="addItemImgInput" class="d-none" accept="image/*">
                </div>
              </div>

              <!-- Item Name -->
              <div class="form-group">
                <label for="addItemName" class="portal-form-label">Item Name</label>
                <input type="text" class="portal-input" id="addItemName" placeholder="e.g. Garlic Naan" required>
              </div>

              <!-- Description -->
              <div class="form-group">
                <label for="addItemDesc" class="portal-form-label">Description</label>
                <textarea class="portal-textarea" id="addItemDesc" rows="3" placeholder="Describe flavor, key ingredients..." required></textarea>
              </div>

              <!-- Price & Category Dropdown in row -->
              <div class="form-row-2col">
                <div class="form-group">
                  <label for="addItemPrice" class="portal-form-label">Price (Rs.)</label>
                  <input type="number" class="portal-input" id="addItemPrice" placeholder="e.g. 150" min="0" required>
                </div>
                <div class="form-group">
                  <label for="addItemCategory" class="portal-form-label">Category</label>
                  <select class="portal-select" id="addItemCategory" required>
                    <option value="" disabled selected>Select...</option>
                    <option value="Naan">Naan</option>
                    <option value="Biryani">Biryani</option>
                    <option value="BBQ">BBQ</option>
                    <option value="Drinks">Drinks</option>
                    <option value="Desserts">Desserts</option>
                    <option value="Fast Food">Fast Food</option>
                    <option value="Others">Others</option>
                  </select>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn-portal btn-portal-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn-portal btn-portal-primary">Add Item</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ============================================== -->
    <!-- 2. EDIT ITEM MODAL -->
    <!-- ============================================== -->
    <div class="portal-modal" id="editItemModal">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header header-primary">
            <h5 class="modal-title"><i class="bi bi-pencil"></i> Edit Menu Item</h5>
            <button type="button" class="btn-modal-close" data-bs-dismiss="modal" aria-label="Close">&times;</button>
          </div>
          <form id="editItemForm" class="portal-form" novalidate>
            <div class="modal-body">
              <!-- Image Upload -->
              <div class="form-group mb-3">
                <label class="portal-form-label">Food Image</label>
                <div class="portal-upload-zone" onclick="document.getElementById('editItemImgInput').click()">
                  <div id="editItemPlaceholder" class="upload-placeholder">
                    <i class="bi bi-camera upload-icon"></i>
                    <p class="upload-prompt">Click to select food picture</p>
                    <p class="upload-help">JPG, PNG format (Leave empty to keep existing)</p>
                  </div>
                  <div id="editItemPreviewWrapper" class="upload-preview-wrapper d-none">
                    <img id="editItemImgPreview" src="#" alt="Food Preview" class="upload-preview-image">
                    <p class="upload-success-text"><i class="bi bi-check-circle-fill"></i> Image Loaded</p>
                  </div>
                  <input type="file" id="editItemImgInput" class="d-none" accept="image/*">
                </div>
              </div>

              <!-- Item Name -->
              <div class="form-group">
                <label for="editItemName" class="portal-form-label">Item Name</label>
                <input type="text" class="portal-input" id="editItemName" required>
              </div>

              <!-- Description -->
              <div class="form-group">
                <label for="editItemDesc" class="portal-form-label">Description</label>
                <textarea class="portal-textarea" id="editItemDesc" rows="3" required></textarea>
              </div>

              <!-- Price & Category Dropdown in row -->
              <div class="form-row-2col">
                <div class="form-group">
                  <label for="editItemPrice" class="portal-form-label">Price (Rs.)</label>
                  <input type="number" class="portal-input" id="editItemPrice" min="0" required>
                </div>
                <div class="form-group">
                  <label for="editItemCategory" class="portal-form-label">Category</label>
                  <select class="portal-select" id="editItemCategory" required>
                    <option value="Naan">Naan</option>
                    <option value="Biryani">Biryani</option>
                    <option value="BBQ">BBQ</option>
                    <option value="Drinks">Drinks</option>
                    <option value="Desserts">Desserts</option>
                    <option value="Fast Food">Fast Food</option>
                    <option value="Others">Others</option>
                  </select>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn-portal btn-portal-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn-portal btn-portal-primary">Update Item</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ============================================== -->
    <!-- 3. DELETE CONFIRMATION MODAL -->
    <!-- ============================================== -->
    <div class="portal-modal modal-danger-size" id="deleteItemModal">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-body text-center portal-delete-modal-body">
            <i class="bi bi-exclamation-triangle text-danger-icon"></i>
            <h5 class="delete-modal-title">Delete Menu Item</h5>
            <p class="delete-modal-subtitle">Are you sure you want to delete this item? This action cannot be undone.</p>
            <div class="delete-modal-actions">
              <button type="button" class="btn-portal btn-portal-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="button" id="confirmDeleteBtn" class="btn-portal btn-portal-danger">Delete</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%- include('../partials/manager-footer') %>