<%- include('../partials/head') %>
<%- include('../partials/rider-navbar') %>

<script>
  // Enable Rider Theme dark style
  document.body.classList.add('rider-theme');
  // Inject Order ID into window scope for scripts
  window.RIDER_ORDER_ID = "<%= orderId %>";
</script>

<div class="rider-container">
  <!-- Back Row & Title -->
  <div class="back-btn-wrapper" style="margin-bottom: 24px;">
    <button class="back-to-home-btn" onclick="window.location.href='/rider'" style="color: #94A3B8;">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to Delivery Queue
    </button>
  </div>

  <header class="rider-header-block">
    <div>
      <h1 style="font-size: 1.6rem;">Delivery Console: <span id="rider-order-id-display" style="color: var(--color-tandoori);"><%= orderId %></span></h1>
      <p style="color: #94A3B8; margin-top: 4px;">Connected as live dispatch rider</p>
    </div>
    <span class="rider-badge" id="rider-connection-status">Connecting Sockets...</span>
  </header>

  <!-- 3-Column Workspace -->
  <div class="rider-workspace-grid">
    
    <!-- Column 1: Status Stepper & Customer Details -->
    <aside class="rider-sidebar-column">
      
      <!-- Stepper Controls Card -->
      <div class="rider-card">
        <h3>Delivery Progress</h3>
        
        <div class="rider-status-list">
          <div class="rider-status-step" id="step-placed">
            <span class="status-step-icon">🥣</span>
            <div>
              <strong>Order Placed</strong>
              <div class="step-timestamp" id="ts-placed">--:--</div>
            </div>
          </div>
          
          <div class="rider-status-step" id="step-preparing">
            <span class="status-step-icon">🔥</span>
            <div>
              <strong>Kitchen Preparing</strong>
              <div class="step-timestamp" id="ts-preparing">--:--</div>
            </div>
          </div>
          
          <div class="rider-status-step" id="step-ontheway">
            <span class="status-step-icon">🛵</span>
            <div>
              <strong>On The Way</strong>
              <div class="step-timestamp" id="ts-ontheway">--:--</div>
            </div>
          </div>
          
          <div class="rider-status-step" id="step-delivered">
            <span class="status-step-icon">✅</span>
            <div>
              <strong>Delivered</strong>
              <div class="step-timestamp" id="ts-delivered">--:--</div>
            </div>
          </div>
        </div>
        
        <!-- Stepper Transition Button -->
        <button class="status-action-btn" id="action-stepper-btn">
          Start Preparing Order
        </button>
      </div>

      <!-- Customer Details Card -->
      <div class="rider-card">
        <h3>Delivery Address Details</h3>
        
        <div class="detail-info-row">
          <strong>Receiver:</strong>
          <span id="cust-name">Loading...</span>
        </div>
        <div class="detail-info-row">
          <strong>Phone:</strong>
          <span id="cust-phone">Loading...</span>
        </div>
        <div class="detail-info-row">
          <strong>Destination:</strong>
          <span id="cust-address">Loading...</span>
        </div>
        <div class="detail-info-row" id="cust-instructions-row" style="display: none;">
          <strong>Notes:</strong>
          <span id="cust-instructions" style="color: var(--color-tandoori); font-weight: 500;"></span>
        </div>
        <div class="detail-info-row">
          <strong>Payment:</strong>
          <span id="order-payment">Loading...</span>
        </div>
      </div>
    </aside>

    <!-- Column 2: Leaflet Tracking Map -->
    <main class="rider-map-column">
      <div class="rider-map-wrapper">
        <div id="rider-map"></div>
        
        <!-- Simulation Control Bar -->
        <div class="map-control-overlay">
          <button class="simulate-btn" id="simulate-ride-btn" disabled>
            <span>🏍️</span> Start Riding (Simulate Travel)
          </button>
        </div>
      </div>

      <!-- Active Order Items Summary Card -->
      <div class="rider-card">
        <h3>Basket Summary</h3>
        <div id="rider-items-list" style="display: flex; flex-direction: column; gap: 10px;">
          <!-- Populated dynamically -->
        </div>
        <div style="margin-top: 15px; border-top: 1px solid rgba(255,255,255,0.06); padding-top: 15px; display: flex; justify-content: space-between; font-weight: 700;">
          <span>Total Paid Collected</span>
          <span style="color: #5CA136;" id="rider-order-total">Rs --</span>
        </div>
      </div>
    </main>

    <!-- Column 3: Live Chat Panel with Customer -->
    <section class="rider-chat-column">
      <div class="rider-card" style="margin-bottom: 0;">
        <h3>Customer Live Chat</h3>
        
        <div class="rider-chat-msg-log" id="rider-chat-msg-log">
          <!-- Populated by Socket messages -->
          <div class="message-bubble rider-incoming" style="align-self: center; background-color: rgba(255,255,255,0.03); border-radius: 8px; font-size: 0.8rem; color: #94A3B8;">
            Welcome to live dispatcher room. Wait for connection...
          </div>
        </div>
        
        <form class="chat-input-bar" id="rider-chat-form" onsubmit="return false;" style="display: flex; gap: 8px; border-top: 1.5px solid rgba(255,255,255,0.06); padding-top: 12px;">
          <input type="text" id="rider-chat-input" placeholder="Type a message to Saad..." required autocomplete="off" 
                 style="flex: 1; padding: 12px; border-radius: 8px; border: 1.5px solid rgba(255,255,255,0.08); background-color: rgba(0,0,0,0.2); color: white; outline: none; font-size: 0.9rem;" />
          <button type="submit" style="background-color: var(--color-tandoori); border: none; width: 44px; height: 44px; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: white;">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
            </svg>
          </button>
        </form>
      </div>
    </section>

  </div>
</div>

<!-- LEAFLET & SOCKETS DEPENDENCIES -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
<script src="/js/rider-deliver.js"></script>

<%- include('../partials/footer') %>
