<%- include('../partials/head') %>
<%- include('../partials/rider-navbar') %>

<script>
  // Enable Rider Theme dark style
  document.body.classList.add('rider-theme');
</script>

<div class="rider-container">
  <!-- Header Row -->
  <header class="rider-header-block">
    <div>
      <h1><span>🛵</span> Rider Delivery Console</h1>
      <p style="color: #94A3B8; margin-top: 4px;">Steer your way to deliver hot, steaming Naans across Islamabad</p>
    </div>
    <span class="rider-badge">Duty: Online</span>
  </header>

  <!-- Orders Queue Listing -->
  <main>
    <h2 style="font-size: 1.35rem; font-weight: 600; margin-bottom: 20px;">Active Deliveries Queue</h2>
    
    <div class="orders-queue-grid" id="orders-queue-container">
      <!-- Loading State -->
      <div class="no-orders-box" id="loading-box">
        <h3 style="color: #94A3B8;">Loading orders...</h3>
      </div>
      
      <!-- No Orders State (Hidden by default) -->
      <div class="no-orders-box" id="empty-box" style="display: none;">
        <span>🍽️</span>
        <h3>No Pending Deliveries</h3>
        <p>No active orders are currently in preparation. Place a new order on the home page first!</p>
        <button onclick="window.location.href='/'" style="margin-top: 20px; background: var(--color-tandoori); color: white; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;">
          Go to Customer Portal
        </button>
      </div>
    </div>
  </main>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const ordersContainer = document.getElementById('orders-queue-container');
    const loadingBox = document.getElementById('loading-box');
    const emptyBox = document.getElementById('empty-box');

    // Retrieve orders from localStorage
    const orders = JSON.parse(localStorage.getItem('naannow_orders')) || [];
    
    // Filter active orders (not delivered yet)
    const activeOrders = orders.filter(o => o.status !== 'Delivered');

    // Remove loading box
    if (loadingBox) loadingBox.remove();

    if (activeOrders.length === 0) {
      emptyBox.style.display = 'block';
      return;
    }

    // Render each active order card
    activeOrders.forEach(order => {
      const card = document.createElement('div');
      card.className = 'order-queue-card';
      
      // Sum items string
      let itemsSummary = '';
      if (Array.isArray(order.items)) {
        itemsSummary = order.items.map(item => `${item.quantity}x ${item.name}`).join(', ');
      } else {
        itemsSummary = order.items; // Fallback string if any
      }

      card.innerHTML = `
        <div class="queue-card-header">
          <span class="queue-card-id">${order.id}</span>
          <span class="queue-card-date">${order.date}</span>
        </div>
        
        <div class="queue-card-body">
          <div class="queue-meta-row">
            <strong>Customer:</strong>
            <span>${order.receiver || 'Saad'}</span>
          </div>
          <div class="queue-meta-row">
            <strong>Phone:</strong>
            <span>${order.phone || '+92 300 1234567'}</span>
          </div>
          <div class="queue-meta-row">
            <strong>Address:</strong>
            <span style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">
              ${order.address || 'F-11, Islamabad'}
            </span>
          </div>
          <div class="queue-meta-row">
            <strong>Items:</strong>
            <span style="font-weight: 500; color: #E57919;">${itemsSummary}</span>
          </div>
          <div class="queue-meta-row">
            <strong>Amount:</strong>
            <span style="font-weight: 700; color: #5CA136;">Rs ${order.total}</span>
          </div>
        </div>

        <button class="queue-card-action-btn" onclick="window.location.href='/rider/deliver/${order.id}'">
          Accept & Deliver Order 🛵
        </button>
      `;

      ordersContainer.appendChild(card);
    });
  });
</script>

<%- include('../partials/footer') %>
