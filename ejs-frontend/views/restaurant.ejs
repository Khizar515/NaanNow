<%- include('partials/head') %>
<%- include('partials/navbar') %>
<%- include('partials/cart-sidebar') %>

<div class="restaurant-detail-container">
  <!-- Back Button Row -->
  <div class="back-btn-wrapper">
    <button class="back-to-home-btn" onclick="window.location.href='/'">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to Restaurants
    </button>
  </div>

  <!-- Hero Header Block -->
  <header class="restaurant-hero">
    <img src="<%= restaurant.rawImage %>" alt="<%= restaurant.name %>" class="hero-cover-img" />
    <div class="hero-overlay">
      <div class="hero-content-card">
        <div class="hero-title-row">
          <h1><%= restaurant.name %></h1>
          <div class="hero-rating">
            <span class="star-icon">★</span>
            <span><%= restaurant.rating %></span>
          </div>
        </div>

        <p class="hero-cuisine"><%= restaurant.cuisine %></p>

        <div class="hero-meta-row">
          <div class="meta-item">
            <span class="meta-icon">🕒</span>
            <span><%= restaurant.deliveryTime %></span>
          </div>
          <div class="meta-item">
            <span class="meta-icon">🛵</span>
            <span><%= restaurant.deliveryFee %></span>
          </div>
          <% if (restaurant.deal) { %>
            <div class="meta-item">
              <span class="meta-deal-badge"><%= restaurant.deal %></span>
            </div>
          <% } %>
          <% if (restaurant.isSuper) { %>
            <div class="meta-item">
              <span class="meta-super-badge">🎖️ Super</span>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </header>

  <!-- Two-Column Menu Body -->
  <% 
    // Extract unique categories present in the restaurant's menu
    const uniqueCategories = [...new Set(restaurant.menu.map(item => item.category))];
  %>
  <div class="menu-columns-layout">
    <!-- Left Column: Sticky Sidebar -->
    <aside class="menu-sidebar">
      <h3>Categories</h3>
      <ul class="sidebar-links">
        <% uniqueCategories.forEach((category, index) => { %>
          <li>
            <a href="#cat-<%= category.replace(/\s+/g, '-').toLowerCase() %>" 
               class="sidebar-link-btn <%= index === 0 ? 'active' : '' %>"
               onclick="setActiveCategory(this)">
              <%= category %>
            </a>
          </li>
        <% }) %>
      </ul>
    </aside>

    <!-- Right Column: Menu List Area -->
    <main class="menu-content-area">
      <% uniqueCategories.forEach(category => { %>
        <section class="menu-section" id="cat-<%= category.replace(/\s+/g, '-').toLowerCase() %>">
          <h2 class="menu-section-title"><%= category %></h2>
          
          <div class="menu-items-grid">
            <% restaurant.menu.filter(item => item.category === category).forEach(item => { %>
              <article class="menu-item-card">
                <div class="item-details-column">
                  <div class="item-text">
                    <h4><%= item.name %></h4>
                    <p><%= item.description %></p>
                  </div>
                  
                  <div class="item-actions-row">
                    <span class="item-price">Rs <%= item.price %></span>
                    <button class="add-to-cart-btn" 
                            data-id="<%= item.id %>" 
                            data-name="<%= item.name %>" 
                            data-price="<%= item.price %>" 
                            data-image="<%= item.image %>">
                      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
                      </svg>
                      Add to Tokri
                    </button>
                  </div>
                </div>
                
                <div class="item-image-wrapper">
                  <img src="<%= item.image %>" alt="<%= item.name %>" class="item-img" loading="lazy" />
                </div>
              </article>
            <% }) %>
          </div>
        </section>
      <% }) %>
    </main>
  </div>
</div>

<script>
  // Script to highlight active category in sticky menu
  function setActiveCategory(selectedLink) {
    document.querySelectorAll('.sidebar-link-btn').forEach(link => {
      link.classList.remove('active');
    });
    selectedLink.classList.add('active');
  }

  // Smooth highlighted transition as user scrolls down menu sections
  window.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('.menu-section');
    const navLinks = document.querySelectorAll('.sidebar-link-btn');

    const observerOptions = {
      root: null,
      rootMargin: '-150px 0px -60% 0px',
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href === `#${id}`) {
              link.classList.add('active');
            } else {
              link.classList.remove('active');
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach(section => observer.observe(section));
  });
</script>

<%- include('partials/footer') %>
